# Otomatizon Production Environment Variables

# 1. Resend Email API Key (for real OTP verification emails)
# Get yours at https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here

# 2. Sender Email Address (default is onboarding@resend.dev during testing)
EMAIL_FROM=Otomatizon <onboarding@resend.dev>

# 3. Server Port (default 3001)
PORT=3001
